# Copie este arquivo para .env (na mesma pasta) e coloque a sua chave.
# O .env nunca vai para o git: ele está no .gitignore.
#
# Escolha UM fornecedor: deixe o bloco dele ativo e o outro comentado (#).
# Para ver os modelos disponíveis na sua conta: python experimentos/02-tema-e-referencia/llm.py

# --- Groq: chave em https://console.groq.com/keys ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=cole_sua_chave_aqui
LLM_MODEL=openai/gpt-oss-120b

